{
  "name": "first-shift",
  "version": "0.1.0",
  "description": "A stylized 3D game that trains new waiters while teaching a foreign language.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && vite build",
    "build:file": "npm run audio:manifest && vite build --config vite.single.config.ts && node scripts/rename-single.mjs",
    "audio": "tsx scripts/audio-script.ts",
    "audio:manifest": "tsx scripts/audio-script.ts --manifest",
    "predev": "npm run audio:manifest",
    "prebuild": "npm run audio:manifest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.187.0"
  },
  "private": true,
  "type": "module"
}
